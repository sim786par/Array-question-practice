#include<bits/stdc++.h>
using namespace std;
class Array{
    public:
    int size;
    int *arr;
    int length;

    Array(int input_array[],int n,int s){
        size = s;
        arr = new int[size];
        length = n;
        for(int i=0;i<n;i++){
            arr[i] = input_array[i];
        }
    }
  
    bool isSorted(){
        for(int i=0;i<length;i++){
            return(arr[i]>arr[i+1]);                     //it return true and false according to the condition in the return
        }       
    }
    void printarr(){
        for(int i=0;i<length;i++){
            cout<< arr[i] <<" ";
        }
        cout<<endl;
    }
    ~Array(){
        delete[] arr;
    }    
};

int main(){
    int array1[] = {2,3,14,15,20,24};
    int array2[] = {24,10,4,76};
    int length1 = sizeof(array1)/sizeof(array1[0]);
    int length2 = sizeof(array2)/sizeof(array2[0]);
    int x=17;
    int n =10;

    Array a1(array1,length1,n);
    Array a2(array2,length1,n);

    a1.printarr();
    cout<< (a1.isSorted() ? "unsorted" : "sorted")<<endl;                          //if true unsorted else sorted
    a2.printarr();
    cout<< (a2.isSorted() ? "unsorted" : "sorted")<<endl;   
    
}
time complexity O(n)   It is the best case because we have to check for all the element in the array
